{
  "manifest_version": 3,
  "name": "Subline — YouTube subtitles",
  "version": "0.1.0",
  "description": "Your locally translated subtitles, synchronized with YouTube.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Subline subtitles" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"] }],
  "externally_connectable": { "matches": ["http://localhost/*", "http://127.0.0.1/*"] }
}
